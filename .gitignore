# ==============================
# ROSY - Chats  —  .gitignore
# ==============================

# ── Python / Django (backend) ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environment
venv/
.venv/
env/
.env_python/

# Django
*.log
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# Environment variables
backend/.env
backend/.env.local

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# ── Node.js / React (frontend) ────────────────────────────────────────
node_modules/
frontend/node_modules/

# Vite build output
frontend/dist/
frontend/build/

# Environment variables
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Vite cache
frontend/.vite/

# ── Temporary uploaded files (app runtime) ────────────────────────────
/tmp/chatroom/

# ── OS & system files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDE & editor ──────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ── Misc ──────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
.cache/
coverage/
.coverage
htmlcov/
